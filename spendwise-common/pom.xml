<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.spendwise</groupId>
        <artifactId>spendwise-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>spendwise-common</artifactId>
    <packaging>jar</packaging>
    <name>SpendWise :: Common</name>
    <description>Cross-cutting DTOs, exception types, correlation-ID filter, the signed
        user-context filter (Milestone 6), the shared RFC 7807 ProblemDetail exception
        handler (Milestone 7), and the shared Bean Validation groups and custom currency
        constraint (Milestone 8) shared by every service</description>

    <dependencies>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- "provided" deliberately, same as jakarta.servlet-api above: AbstractGlobalExceptionHandler
             (Milestone 7) extends the servlet-only ResponseEntityExceptionHandler, but this must
             never become a transitive dependency of api-gateway, whose WebFlux/Netty runtime has
             no servlet container and no jakarta.servlet-api on its classpath at all. Spring Boot's
             WebApplicationType.deduceFromClasspath() falls back to SERVLET/NONE detection the moment
             a DispatcherServlet class is resolvable but no servlet API is present, which would break
             api-gateway's reactive startup outright. "provided" scope is not transitive, so consumers
             never pull this in unless they declare it themselves (every servlet-based service already
             does, via spring-boot-starter-web) — api-gateway never scans this package, so the class is
             never loaded there. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Milestone 15 — "provided" for the exact same reason as spring-webmvc above,
             mirrored for the opposite stack: AbstractReactiveGlobalExceptionHandler and
             the Reactive*Filter classes in tracing/security below extend/implement
             WebFlux-only types (ResponseEntityExceptionHandler, WebFilter), but this must
             never become a transitive dependency of every servlet-based service (budget-
             service, auth-service, etc.), whose Tomcat-based runtime has no event-loop
             Netty server and no use for Reactor's types at all. "provided" scope is not
             transitive, so analytics-service — this platform's only WebFlux service, and
             the only one that scans this package's reactive classes — is the one consumer
             that must (and does, via spring-boot-starter-webflux) declare this dependency
             itself for those classes to ever be loaded. -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Milestone 8 — the custom @ValidCurrencyCode constraint and the OnCreate/OnUpdate
             validation-group marker interfaces live in this module (validation package) so
             every service shares one definition instead of each redeclaring its own currency
             constraint. Only the API is needed here (annotations + SPI interfaces); the actual
             constraint-validation engine (Hibernate Validator) is pulled in transitively by
             each consuming service's own spring-boot-starter-validation dependency, exactly
             the same "API here, implementation at the edge" split already used for the servlet
             API above. -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Milestone 10 — needed only to compile SpendwiseFeignTracingAutoConfiguration's
             RequestInterceptor bean against Feign's API. "optional" keeps this from leaking
             as a mandatory transitive dependency into services (config-server, auth-service,
             etc.) that never put spring-cloud-starter-openfeign on their own classpath — the
             same "API here, implementation/starter at the edge" split already used for
             spring-webmvc and jakarta.servlet-api above. -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Milestone 18 — needed only to compile the messaging package
             (SpendwiseKafkaConsumerAutoConfiguration and the record interceptor,
             rebalance listener and actuator endpoint it registers). Optional, same
             as feign-core above: services without spring-kafka never get it, and
             the auto-configuration is @ConditionalOnClass on it. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Milestone 18 — Counter/MeterRegistry for the consumed-records metric.
             Every consuming service already has it through spring-boot-starter-actuator. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
