{
  "type": "record",
  "name": "TransactionReversedEvent",
  "namespace": "com.spendwise.events.avro",
  "doc": "A ledger entry was compensated by a reversing entry (Functional Roadmap, Workflow 2, Step 4). Published by transaction-service's outbox relay to transaction-events, keyed by the original transactionId.",
  "fields": [
    {"name": "transactionId", "type": "string", "doc": "UUID of the reversed (original) entry."},
    {"name": "reversalTransactionId", "type": "string", "doc": "UUID of the compensating entry."},
    {"name": "userId", "type": "string", "doc": "UUID of the owning user."},
    {"name": "categoryId", "type": "string", "doc": "UUID of the category in transaction_db."},
    {"name": "categoryName", "type": ["null", "string"], "default": null, "doc": "Category name."},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 2}, "doc": "The original entry's amount, positive."},
    {"name": "type", "type": "string", "doc": "INCOME or EXPENSE."},
    {"name": "transactionDate", "type": {"type": "int", "logicalType": "date"}, "doc": "Business date of the original entry."},
    {"name": "currency", "type": "string", "doc": "ISO 4217 code of amount."},
    {"name": "baseCurrencyAmount", "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 2}], "default": null, "doc": "The original's base-currency amount, if it was converted."},
    {"name": "reason", "type": "string", "doc": "Why it was reversed."},
    {"name": "reversedAt", "type": {"type": "long", "logicalType": "timestamp-millis"}, "doc": "When the reversal was recorded."}
  ]
}
