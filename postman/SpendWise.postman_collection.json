{
  "info": {
    "name": "SpendWise",
    "description": "Java 21 / Spring Boot 3.4+ microservices monorepo \u2014 one folder per service, each with its business endpoints plus Actuator and (pending) Metrics subfolders. Import once; folders for not-yet-built capabilities are pre-scaffolded so this collection doesn't need re-importing as later milestones land.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "configServerUrl",
      "value": "http://localhost:8888"
    },
    {
      "key": "authServiceUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "userServiceUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "transactionServiceUrl",
      "value": "http://localhost:8083"
    },
    {
      "key": "budgetServiceUrl",
      "value": "http://localhost:8084"
    },
    {
      "key": "notificationServiceUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "analyticsServiceUrl",
      "value": "http://localhost:8086"
    },
    {
      "key": "userId",
      "value": "",
      "description": "Paste an id from a Create User response"
    },
    {
      "key": "categoryId",
      "value": "",
      "description": "Paste an id from a Create Category response"
    },
    {
      "key": "credentialId",
      "value": "",
      "description": "Paste an id from a Register response"
    }
  ],
  "item": [
    {
      "name": "Config Server",
      "item": [
        {
          "name": "Fetch user-service config (dev)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{configServerUrl}}/user-service/dev",
              "host": [
                "{{configServerUrl}}"
              ],
              "path": [
                "user-service",
                "dev"
              ]
            },
            "description": "Verifies the Config Server is actually serving centralized config. Try /auth-service/dev, /transaction-service/prod, etc. too."
          },
          "response": []
        },
        {
          "name": "Actuator",
          "item": [
            {
              "name": "Health",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{configServerUrl}}/actuator/health",
                  "host": [
                    "{{configServerUrl}}"
                  ],
                  "path": [
                    "actuator",
                    "health"
                  ]
                },
                "description": "Liveness/readiness aggregate health. Full detail is exposed by management.endpoint.health.show-details."
              },
              "response": []
            },
            {
              "name": "Info",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{configServerUrl}}/actuator/info",
                  "host": [
                    "{{configServerUrl}}"
                  ],
                  "path": [
                    "actuator",
                    "info"
                  ]
                },
                "description": ""
              },
              "response": []
            },
            {
              "name": "Refresh (single-instance)",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{configServerUrl}}/actuator/refresh",
                  "host": [
                    "{{configServerUrl}}"
                  ],
                  "path": [
                    "actuator",
                    "refresh"
                  ]
                },
                "description": "Re-fetches config from the Config Server for THIS instance only. Fleet-wide broadcast via Spring Cloud Bus arrives at Milestone 13."
              },
              "response": []
            }
          ],
          "description": "Exposed since Milestone 2/3 (health, info, refresh)."
        }
      ],
      "description": "Every other service bootstraps its configuration from here (Milestone 2). Start this first."
    },
