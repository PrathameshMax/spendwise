# Production Debugging Lab — these files are executed by bash (Git Bash) or
# mounted into Linux containers (Fluent Bit, the Kibana and Splunk setup jobs),
# where a Windows CRLF line ending breaks them. Keep LF on every checkout.
scripts/lab.sh text eol=lf
infra/elk/** text eol=lf
infra/splunk/** text eol=lf
infra/fluent-bit/** text eol=lf
infra/appdynamics/** text eol=lf
infra/partners/** text eol=lf

# Shell scripts run inside Linux containers (vault-init, kafka-acls) or by bash:
# with CRLF, `set -eu\r` fails ("illegal option") and the job exits 2.
*.sh text eol=lf
infra/vault/** text eol=lf
infra/kafka/secure/** text eol=lf
