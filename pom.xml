<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.spendwise</groupId>
    <artifactId>spendwise-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>SpendWise :: Parent</name>
    <description>Milestone 1 — unified Maven BOM and monorepo reactor for the SpendWise platform</description>

    <modules>
        <module>spendwise-common</module>
        <module>discovery-server</module>
        <module>config-server</module>
        <module>auth-service</module>
        <module>user-service</module>
        <module>transaction-service</module>
        <module>budget-service</module>
        <module>notification-service</module>
        <module>analytics-service</module>
        <module>api-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>3.4.1</spring-boot.version>
        <spring-cloud.version>2024.0.0</spring-cloud.version>
        <spendwise-common.version>1.0.0-SNAPSHOT</spendwise-common.version>
        <!-- Not part of spring-boot-dependencies' BOM, so pinned explicitly here (Milestone 7) -->
        <springdoc-openapi.version>2.7.0</springdoc-openapi.version>
        <!-- Not part of spring-boot-dependencies' BOM either, so pinned explicitly here
             (Milestone 8) — used for compile-time-checked entity-to-response-DTO mapping. -->
        <mapstruct.version>1.6.3</mapstruct.version>
        <!-- Not part of spring-boot-dependencies' or spring-cloud-dependencies' BOM, so
             pinned explicitly here (Milestone 10/11) — the Retry (Milestone 10 timeouts'
             companion) and, from Milestone 12 onward, CircuitBreaker/Bulkhead/TimeLimiter
             primitives layered directly over the Feign clients declared in
             transaction-service and budget-service. -->
        <resilience4j.version>2.2.0</resilience4j.version>
        <!-- Not part of spring-boot-dependencies' or spring-cloud-dependencies' BOM, so
             pinned explicitly here (Milestone 15) — this exact 1.68.1/3.25.5/0.6.1 trio
             is the maintainer-chosen, self-consistent combination grpc-java's own
             official examples module pins (confirmed against
             https://github.com/grpc/grpc-java/blob/v1.68.1/examples/pom.xml), not an
             independently-guessed set of versions: grpc-java and protobuf-java ship on
             separate release cadences, and an uncoordinated pairing is a common source
             of runtime/codegen mismatches this platform has no way to detect before a
             real `mvn compile` runs (no Maven Central access in the build sandbox this
             milestone was authored in — see budget-service/analytics-service pom.xml
             comments for what that does and does not mean for validation). -->
        <grpc.version>1.68.1</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
        <!-- net.devh's starter is a thin autoconfiguration layer (the @GrpcService/
             @GrpcClient annotations and the server/channel lifecycle beans) that does not
             publish its own BOM; grpc-bom above is what actually pins every io.grpc:*
             artifact's version platform-wide, same role spring-boot-dependencies/
             spring-cloud-dependencies play for everything else in this table. Latest
             stable per Maven Central as of this milestone. -->
        <grpc-spring-boot-starter.version>3.1.0.RELEASE</grpc-spring-boot-starter.version>
        <!-- Milestone 17 fix — Maven's super-POM default plugin versions are not
             managed by the imported Boot BOM (a BOM import manages dependencies,
             not plugins), so these two are pinned explicitly for the Mockito
             agent configuration in the mockito-agent profile below. -->
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-dependency-plugin.version>3.8.1</maven-dependency-plugin.version>
        <!-- Empty default so surefire's late-bound @{argLine} below always
             resolves; a plugin that sets argLine itself (e.g. a JaCoCo agent,
             if one is added later) is appended to, not overwritten. -->
        <argLine></argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.spendwise</groupId>
                <artifactId>spendwise-common</artifactId>
                <version>${spendwise-common.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc-openapi.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <!-- Milestone 15 — imported (not just a single artifact version pinned) because
                 grpc-protobuf/grpc-stub/grpc-services/grpc-netty-shaded must all resolve to
                 the SAME grpc-java release in both budget-service (gRPC server) and
                 analytics-service (gRPC client); importing the BOM once here guarantees
                 that platform-wide the same way spring-cloud-dependencies already does for
                 every spring-cloud-starter-* artifact above. -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>${maven-dependency-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!-- Milestone 17 fix — load Mockito's inline mock maker as a -javaagent
             instead of letting it self-attach at runtime. Mockito 5 (via
             spring-boot-starter-test) attaches its byte-buddy agent dynamically
             on first use, which JDK 21 now warns about ("Mockito is currently
             self-attaching to enable the inline-mock-maker... dynamic loading of
             agents will be disallowed by default in a future release", JEP 451).
             Mockito's documented fix: maven-dependency-plugin's `properties` goal
             exposes every dependency's local jar path as a property named
             groupId:artifactId:type, and surefire passes mockito-core's as
             -javaagent. @{argLine} (late-bound, not ${argLine}) keeps anything
             another plugin already put in argLine.

             A profile, activated only for modules that have a src/test/java
             directory, rather than a plain parent-level plugin: spendwise-common
             has no tests and no mockito-core dependency, so
             ${org.mockito:mockito-core:jar} would stay an unresolved literal
             there and the forked test JVM would fail to start on it. -->
        <profile>
            <id>mockito-agent</id>
            <activation>
                <file>
                    <exists>${basedir}/src/test/java</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>resolve-mockito-agent-path</id>
                                <goals>
                                    <goal>properties</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>@{argLine} -javaagent:${org.mockito:mockito-core:jar} -Xshare:off</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
