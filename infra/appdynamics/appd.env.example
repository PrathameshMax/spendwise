# AppDynamics controller connection for the Production Debugging Lab.
#
# 1. Copy this file to infra/appdynamics/appd.env (same folder). appd.env is
#    git-ignored: it holds your access key and must never be committed.
# 2. Fill in the values from your AppDynamics SaaS trial:
#    - Controller host: the host part of your controller URL, e.g. for
#      https://acme-trial.saas.appdynamics.com/controller use acme-trial.saas.appdynamics.com
#    - Account name and access key: in the controller UI, gear icon (Settings)
#      > License > Account. Click "Show" next to Access Key.
# 3. ./scripts/lab.sh start   (it prints "AppDynamics agent: ON")
#
# Delete or rename appd.env to run without the agent again.

APPDYNAMICS_CONTROLLER_HOST_NAME=your-account.saas.appdynamics.com
APPDYNAMICS_CONTROLLER_PORT=443
APPDYNAMICS_CONTROLLER_SSL_ENABLED=true
APPDYNAMICS_AGENT_ACCOUNT_NAME=your-account
APPDYNAMICS_AGENT_ACCOUNT_ACCESS_KEY=paste-your-access-key-here
